# Gemini Mortgage Concierge - Environment Configuration

# ===================
# REQUIRED: Gemini API
# ===================
GEMINI_API_KEY=your_gemini_api_key_here

# ===================
# OPTIONAL: Port Configuration (defaults shown)
# ===================
BROKER_PORT=4020
VISION_PORT=4023
UNDERWRITER_PORT=4001
QA_PORT=4024
FRONTEND_PORT=8100

# ===================
# OPTIONAL: Agent URLs (for remote deployment)
# Leave empty to use localhost with ports above
# ===================
# VISION_URL=https://your-vision-agent.run.app
# UNDERWRITER_URL=https://your-underwriter-agent.run.app
# QA_URL=https://your-qa-agent.run.app

# ===================
# OPTIONAL: Regulations File
# ===================
# REGULATIONS_FILE=regulations.pdf
# REGULATIONS_MIME_TYPE=application/pdf
