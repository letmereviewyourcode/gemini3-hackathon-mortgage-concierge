FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies (tsx is usually in devDeps or we use npx)
# Make sure to install ALL dependencies
RUN npm ci

# Copy source including regulations file
COPY . .

# IMPORTANT: regulations.txt must be in this directory
# It will be uploaded to Files API at startup

# Cloud Run uses PORT env var
ENV PORT=8080
EXPOSE 8080

# Standard start command (uses ts-node from package.json)
CMD ["npm", "start"]
